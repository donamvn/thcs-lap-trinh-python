flowchart TD
    s1(["Bắt đầu"])
    a[/"Nhập danh sách a"/]
    b["n = len(a)<br/>i = 0"]
    c{"i #lt; n - 1 ?"}
    d["j = 0"]
    f{"j #lt; n - 1 - i ?"}
    g{"a[j] #gt; a[j+1] ?"}
    h["Đổi chỗ a[j] và a[j+1]"]
    k["j = j + 1"]
    m["i = i + 1"]
    o[/"In danh sách a đã sắp xếp"/]
    e1(["Kết thúc"])
    s1 --> a
    a --> b
    b --> c
    c -->|Đúng| d
    d --> f
    f -->|Đúng| g
    g -->|Đúng| h
    h --> k
    g -->|Sai| k
    k --> f
    f -->|Sai| m
    m --> c
    c -->|Sai| o
    o --> e1
    classDef batdau fill:#b2f2bb,stroke:#2b8a3e,color:#000
    class s1,e1 batdau
    classDef nhapxuat fill:#a5d8ff,stroke:#1971c2,color:#000
    class a,o nhapxuat
    classDef xuly fill:#ffec99,stroke:#e67700,color:#000
    class b,d,h,k,m xuly
    classDef dieukien fill:#ffc9c9,stroke:#c92a2a,color:#000
    class c,f,g dieukien