flowchart TD
    s1(["Bắt đầu"])
    a[/"Nhập n (ví dụ 472)"/]
    b["tram = n // 100"]
    c["chuc = (n // 10) % 10"]
    d["don_vi = n % 10"]
    f[/"In ra tram + chuc + don_vi"/]
    e1(["Kết thúc"])
    s1 --> a
    a --> b
    b --> c
    c --> d
    d --> f
    f --> e1
    classDef batdau fill:#b2f2bb,stroke:#2b8a3e,color:#000
    class s1,e1 batdau
    classDef nhapxuat fill:#a5d8ff,stroke:#1971c2,color:#000
    class a,f nhapxuat
    classDef xuly fill:#ffec99,stroke:#e67700,color:#000
    class b,c,d xuly