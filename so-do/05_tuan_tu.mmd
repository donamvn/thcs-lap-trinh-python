flowchart TD
    s1(["Bắt đầu"])
    a[/"Nhập danh sách a, giá trị x"/]
    b["i = 0"]
    c{"i #lt; len(a) ?"}
    d{"a[i] == x ?"}
    d1[/"Tìm thấy tại vị trí i"/]
    f["i = i + 1"]
    g[/"Không tìm thấy (-1)"/]
    e1(["Kết thúc"])
    s1 --> a
    a --> b
    b --> c
    c -->|Đúng| d
    d -->|Đúng| d1
    d -->|Sai| f
    f --> c
    c -->|Sai| g
    g --> e1
    d1 --> e1
    classDef batdau fill:#b2f2bb,stroke:#2b8a3e,color:#000
    class s1,e1 batdau
    classDef nhapxuat fill:#a5d8ff,stroke:#1971c2,color:#000
    class a,d1,g nhapxuat
    classDef xuly fill:#ffec99,stroke:#e67700,color:#000
    class b,f xuly
    classDef dieukien fill:#ffc9c9,stroke:#c92a2a,color:#000
    class c,d dieukien